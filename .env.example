# Copy to .env (Docker) or export in your shell. Everything is optional: with no values Dëgg runs fully in DEMO mode.
PORT=8080
# Claude for multilingual parsing + summaries (falls back to rules if unset)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# ...or a free Google Gemini key from https://aistudio.google.com/apikey (used if no Anthropic key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Operator wallet (NWC, needs make_invoice + lookup_invoice) for anti-spam deposits. Unset = demo invoices.
NWC_URL=
DEPOSIT_SATS=10
REQUIRE_DEPOSIT=1
# Comma-separated Nostr relays to mirror signed reports to (optional)
RELAYS=
DB_PATH=./data/degg.db
